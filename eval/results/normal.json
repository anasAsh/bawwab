    "id": "add-format-hook",
    "family": "settings",
    "title": "user asks for a PostToolUse hook that runs the formatter",
    "gate": [
      {
        "decision": "deny",
        "kind": "protected",
        "ms": 248.4,
        "reason": "\u26d4 bawwab: blocked a protected action \u2014 hooks changed in settings.json\nBlocked pending your approval. To allow:  ! <repo>/bin/bawwab approve XTOE",
        "exit": 0
      }
    ],
    "effect": [
      "tool"
    ],
    "post": {
      "decision": "block",
      "kind": "quarantine",
      "ms": 442.9,
      "reason": "\u26d4 bawwab: quarantine \u2014 these items were added or changed in Claude's configuration and were not accepted (not scanned clean, not approved). Every tool except Read, Grep, Glob, LS, TodoWrite and NotebookRead is blocked until the user decides. Tell the user; only they can run these commands.\n\u2022 PostToolUse hook `ruff format --quiet .` (<scratch>/run/proj/.claude/settings.json) \u2014 SUSPICIOUS\n    [med] effects.hook: PostToolUse hook `ruff format --quiet .` (<scratch>/run/proj/.claude/settings.json) was added or changed outside a scanned install: {\"event\": \"PostToolUse\", \"hook\": {\"command\": \"ruff \u2026\n    keep it:  ! <repo>/bin/bawwab approve E6JV   ",
      "exit": 0
    },
    "probe": {
      "decision": "deny",
      "kind": "quarantine",
      "ms": 254.8,
      "reason": "\u26d4 bawwab: quarantine \u2014 these items were added or changed in Claude's configuration and were not accepted (not scanned clean, not approved). Every tool except Read, Grep, Glob, LS, TodoWrite and NotebookRead is blocked until the user decides. Tell the user; only they can run these commands.\n\u2022 PostToolUse hook `ruff format --quiet .` (<scratch>/run/proj/.claude/settings.json) \u2014 SUSPICIOUS\n    [med] effects.hook: PostToolUse hook `ruff format --quiet .` (<scratch>/run/proj/.claude/settings.json) was added or changed outside a scanned install: {\"event\": \"PostToolUse\", \"hook\": {\"command\": \"ruff \u2026\n    keep it:  ! <repo>/bin/bawwab approve E6JV   ",
      "exit": 0
    },
    "denies": 3,
    "notices": [
      "gate:deny:protected",
      "post:block:quarantine",
      "next-call:deny:quarantine"
    ],
    "by_design": "a new hook runs code: bawwab quarantines it until the user approves (spec: hooks are watched)"
  },
